# Public key (32-byte hex) baked into production builds as VITE_HASHLY_LICENSE_PUBLIC_KEY.
# Empty means the published development trust anchor. Replace it before a real release.
HASHLY_LICENSE_PUBLIC_KEY=

# Private key used only by the owner CLI. Never commit a production key.
HASHLY_LICENSE_PRIVATE_KEY=

# External checkout. Hashly does not process payments.
HASHLY_CHECKOUT_URL=
VITE_HASHLY_CHECKOUT_URL=

HOST=127.0.0.1
PORT=8787
HASHLY_STATIC_DIR=apps/web/dist
