{
  "name": "hashly",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Hashly — non-custodial wallet and mining dashboard. It does not hold funds or sell hashrate.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "cli/*"
  ],
  "scripts": {
    "dev": "HASHLY_SERVER=1 npm run dev -w @hashly/server",
    "dev:web": "npm run dev -w @hashly/web",
    "start": "HASHLY_SERVER=1 HASHLY_STATIC_DIR=apps/web/dist node apps/server/dist/index.cjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck && eslint .",
    "build:web": "npm run build -w @hashly/web",
    "build:server": "node scripts/bundle.mjs server",
    "build:cli": "node scripts/bundle.mjs cli",
    "build:desktop": "node scripts/bundle.mjs desktop",
    "build": "npm run build:web && npm run build:server && npm run build:cli && npm run build:desktop",
    "license": "tsx cli/license/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@types/express": "4.17.21",
    "@types/node": "22.13.4",
    "esbuild": "0.25.0",
    "eslint": "9.21.0",
    "playwright": "^1.49.1",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.1",
    "vitest": "3.0.5"
  }
}
